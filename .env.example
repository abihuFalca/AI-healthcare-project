# =============================================================================
# .env.example  —  Environment variable TEMPLATE
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file and name the copy exactly:  .env
#      (Windows PowerShell command from the project root:)
#         Copy-Item .env.example .env
#
#   2. Open .env and replace every placeholder value (shown in ALL_CAPS)
#      with your real credentials.
#
#   3. Never commit .env to Git.
#      It is already listed in .gitignore — check before every commit.
#
#   4. This .env.example file IS safe to commit — it contains no real secrets.
#      Keep it updated whenever new variables are added.
#
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE — Supabase PostgreSQL connection string
# -----------------------------------------------------------------------------
#
# Where to find this:
#   Supabase Dashboard → Your Project → Project Settings (gear icon)
#   → Database → Connection string → URI tab
#   It looks like:
#     postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
#
# IMPORTANT: Replace [YOUR-PASSWORD] with your actual database password.
#   Do not use the placeholder here in .env — use the real value.
#   The password is the one you set (or were given) when creating the project.
#
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres


# -----------------------------------------------------------------------------
# JWT SECRET KEY — used to sign and verify login tokens
# -----------------------------------------------------------------------------
#
# This replaces the hard-coded key currently in backend/auth_utils.py.
#
# Rules for choosing a value:
#   - Must be a long, random string (at least 32 characters).
#   - Never reuse a password or a real word.
#   - Generate one safely with this command (run in any terminal with Python):
#       python -c "import secrets; print(secrets.token_hex(32))"
#   - Copy the output into .env.  Keep it private.
#
# IMPORTANT ABOUT GIT HISTORY:
#   The old key ("med_triage_super_secure_clinical_jwt_secret_key_2026") is
#   already committed in Git history in auth_utils.py.  Removing it from the
#   current file does NOT remove it from past commits.
#   For a production deployment you MUST rotate this key (generate a new one)
#   so that any tokens signed with the old key are no longer trusted.
#   For a local demo/prototype where the repo is private, the risk is lower,
#   but rotating is still the right habit.
#
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING_AT_LEAST_32_CHARS


# -----------------------------------------------------------------------------
# PASSWORD HASHING SALT — used to hash user passwords before storage
# -----------------------------------------------------------------------------
#
# This replaces the hard-coded salt string "salt_med_" in database.py and
# auth_utils.py.
#
# Rules:
#   - Must match exactly between .env and the running backend.
#     If you change this after users have registered, their stored password
#     hashes will no longer match and they will not be able to log in.
#   - For this migration keep the value below exactly as shown so that the
#     existing demo accounts (password: demo123) continue to work.
#   - Only change this value when setting up a brand-new deployment with no
#     existing user accounts.
#
PASSWORD_SALT=salt_med_


# -----------------------------------------------------------------------------
# SUPABASE PROJECT DETAILS (optional — for future Supabase Auth integration)
# -----------------------------------------------------------------------------
#
# You do not need these for the current migration.
# They are included here so the template is ready when Supabase Auth is added
# as a future phase.
#
# Where to find them:
#   Supabase Dashboard → Your Project → Project Settings → API
#
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE


# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
#
# The environment the app is running in.
# Use "development" locally, "production" on a live server.
# The backend can use this to toggle debug logging.
#
APP_ENV=development

# -----------------------------------------------------------------------------
# AI provider (free options: gemini or groq)
#   gemini: free key at https://aistudio.google.com/apikey
#   groq:   free key at https://console.groq.com/keys
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model override (defaults: gemini-flash-lite-latest / llama-3.3-70b-versatile)
LLM_MODEL=

# =============================================================================
# END OF .env.example
# =============================================================================
